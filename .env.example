# --- Client-Safe (Browser Bundle: VITE_* prefix ONLY) ---
VITE_APP_ENV="development"
VITE_APP_URL="http://localhost:3000"
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Server-Only (NEVER prefix with VITE_, NEVER expose to browser) ---
NODE_ENV="development"
APP_ENV="development"
PORT="3000"
APP_URL="MY_APP_URL"

SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# Payment Providers (Future P-07 integration; subject to D-07 approval)
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""

# Platform Runtime Placeholder (Unused in MVP; R2-07 AI Assistant excluded)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
