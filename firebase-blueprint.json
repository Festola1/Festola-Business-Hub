{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII workspace profile metadata for an authenticated Festola Business Hub user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Publicly safe display name shown in the workspace shell."
        },
        "defaultBusinessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Primary business workspace document ID owned by the user."
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "description": "Lifecycle status of the user profile."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set on profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp updated on profile modification."
        }
      },
      "required": ["uid", "displayName", "defaultBusinessId", "status", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly owner-only PII sub-document isolating email and phone number.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified account email address."
        },
        "phone": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional phone number."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set on update."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "Business": {
      "title": "Business",
      "description": "Tenant business workspace owned by a verified user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Business workspace identifier."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Immutable Firebase Auth UID of the business owner."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Registered or trading business name."
        },
        "currency": {
          "type": "string",
          "enum": ["NGN", "USD", "GHS", "KES", "GBP"],
          "description": "Primary currency code."
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "description": "Workspace lifecycle status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set on update."
        }
      },
      "required": ["id", "ownerId", "name", "currency", "status", "createdAt", "updatedAt"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Cloud-synced supplier directory record scoped to a parent business workspace.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Supplier document identifier."
        },
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent business workspace ID."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID for rule-enforced list queries."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Supplier company or distributor name."
        },
        "phone": {
          "type": "string",
          "maxLength": 40,
          "description": "Supplier phone number."
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "description": "Supplier contact email."
        },
        "address": {
          "type": "string",
          "maxLength": 240,
          "description": "Supplier warehouse or stall address."
        },
        "productsSupplied": {
          "type": "string",
          "maxLength": 240,
          "description": "Summary of product categories supplied."
        },
        "totalPurchases": {
          "type": "number",
          "description": "Cumulative purchase amount logged for this supplier."
        },
        "outstandingBalance": {
          "type": "number",
          "description": "Remaining unpaid balance owed to this supplier."
        },
        "payments": {
          "type": "array",
          "description": "Bounded recent payment settlement entries (max 50 entries)."
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "description": "Supplier lifecycle state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set on update."
        }
      },
      "required": [
        "id",
        "businessId",
        "ownerId",
        "name",
        "phone",
        "email",
        "address",
        "productsSupplied",
        "totalPurchases",
        "outstandingBalance",
        "payments",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-provisioned platform administrator registry document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Administrator UID."
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Trusted admin role marker."
        }
      },
      "required": ["uid", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "User workspace profile (non-PII fields only)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII subcollection isolating email and phone."
    },
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Master business workspace document owned by a verified user."
    },
    "/businesses/{businessId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Cloud-synced supplier directory and settlement records per business."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Read-only admin verification lookup; client writes strictly denied."
    }
  }
}
